# 镜像固定到具体版本；可替换为已同步的阿里云镜像地址。
JDK_IMAGE=eclipse-temurin:8u512-b09-jdk-jammy
MYSQL_IMAGE=mysql:8.0.46
HADOOP_IMAGE=dp-hadoop-base:3.3.6-jdk8u512
HIVE_IMAGE=dp-hive:3.1.3-hadoop3.3.6
GATEWAY_IMAGE=dp-gateway:m0-02
HADOOP_VERSION=3.3.6
HIVE_VERSION=3.1.3
MYSQL_CONNECTOR_VERSION=8.0.33
HADOOP_DOWNLOAD_URL=https://archive.apache.org/dist/hadoop/common/hadoop-3.3.6/hadoop-3.3.6.tar.gz
HIVE_DOWNLOAD_URL=https://archive.apache.org/dist/hive/hive-3.1.3/apache-hive-3.1.3-bin.tar.gz
MYSQL_CONNECTOR_DOWNLOAD_URL=https://repo.maven.apache.org/maven2/com/mysql/mysql-connector-j/8.0.33/mysql-connector-j-8.0.33.jar

# 以下密码仅用于示例，部署前必须在 deploy/.env 中逐项替换。
# 含 $ 或 # 等特殊字符时，使用 Compose .env 的单引号语法。
MYSQL_ROOT_PASSWORD=example_root_only
SOURCE_DB_PASSWORD=example_source_only
HIVE_DB_PASSWORD=example_hive_only
SCHEDULER_DB_PASSWORD=example_scheduler_only
DATAHUB_DB_PASSWORD=example_datahub_only
PORTAL_DB_PASSWORD=example_portal_only
CDC_DB_PASSWORD=example_cdc_only

SPARK_VERSION=3.5.7
SPARK_DOWNLOAD_URL=https://archive.apache.org/dist/spark/spark-3.5.7/spark-3.5.7-bin-hadoop3.tgz
